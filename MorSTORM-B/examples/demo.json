{
  "schema_version": 1,
  "input": {
    "kind": "localizations",
    "path": "demo_thunderstorm.csv",
    "format": "thunderstorm",
    "coordinate_unit": "nm",
    "frame_base": 1,
    "pixel_size_nm": 160
  },
  "drift": {
    "method": "meanshift",
    "segment_frames": 10,
    "parameters": {
      "meanshift": {
        "nTimeBin": 8
      }
    }
  },
  "render": {
    "pixel_size_nm": 10,
    "max_pixels": 100000000
  },
  "morphology": {
    "enabled": true,
    "fiji_dir": "",
    "sigma_px": 1,
    "threshold": 0.2,
    "connectivity": 8,
    "min_area_nm2": 100,
    "exclude_border": false
  },
  "output_dir": "../results/demo"
}
